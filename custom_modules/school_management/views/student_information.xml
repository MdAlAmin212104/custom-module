<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Student Form View -->
    <record id="view_student_information_form" model="ir.ui.view">
        <field name="name">student.information.form</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <form string="Student Information">

                <header>
                    <button type="object" invisible="status != 'draft'" string="Confirm Student" name="confirm_student" class="btn-primary"/>


                    <button type="object" invisible="status != 'confirmed'" string="Reset to Draft" name="reset_to_draft" class="btn-secondary"/>

                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <field name="image" widget="contact_image" options="{'size': [130,130]}" class="float-end" /> 
                    

                    <group>
                        <group string="Personal Information">
                            <field name="name" readonly="status != 'draft'"/>
                            <field name="roll_number" readonly="status != 'draft'"/>
                            <field name="phone" readonly="status != 'draft'"/>
                            <field name="email" readonly="status != 'draft'"/>
                            <field name="birth_date" readonly="status != 'draft'"/>
                            <field name="class_id" readonly="status != 'draft'" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        </group>
                        <group string="Parent Information">
                            <field name="father_name" readonly="status != 'draft'"/>
                            <field name="mother_name" readonly="status != 'draft'"/>
                            <field name="gender" readonly="status != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Previous Records">
                            <field name="previous_record_ids" readonly="status != 'draft'">
                                <list editable="bottom">
                                    <field name="student_id" column_invisible="1"/>
                                    <field name="other_school_id"/>
                                    <field name="passing_year"/>
                                    <field name="class_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Student Documents">
                            <group name="Upload all kind of student documents here">
                                <field name="student_documents_ids" readonly="status != 'draft'" widget="many2many_binary" options="{'no_create': True}">
                                </field>
                            </group>
                        </page>
                        <page string="Student Notes">
                            <field name="student_notes" placeholder="Write your notes here..."/>
                        </page>
                    </notebook> 
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Student List View -->
    <record id="view_student_information_list" model="ir.ui.view">
        <field name="name">student.information.list</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <list string="Student Information" decoration-muted="status == 'draft'" decoration-success="status == 'confirmed'">
                <field name="image" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded border object-fit-contain'}" width="30" nolabel="1"/>
                <field name="name"/>
                <field name="roll_number"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="class_id"/>
                <field name="birth_date"/>
                <field name="father_name"/>
                <field name="mother_name"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <!-- Student Kanban View -->
    <record model="ir.ui.view" id="student_kanban_view">
        <field name="name">student.information.kanban</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="roll_number"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="image"/>
                <field name="status"/>
                <field name="class_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <div class="o_kanban_image_fill w-100">
                                <field name="image" class="h-100" widget="image"
                                       options="{'img_class': 'object-fit-cover w-100 h-100'}"/>
                            </div>
                        </aside>
                        <main class="ps-2">
                            <div class="mb-1">
                                <field name="name" class="mb-0 fw-bold fs-5"/>
                            </div>
                            <div class="text-muted">
                                Roll: <field name="roll_number"/>
                            </div>
                            <div t-if="record.email.raw_value" class="text-truncate">
                                <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                <field name="email"/>
                            </div>
                            <div t-if="record.phone.raw_value">
                                <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                <field name="phone"/>
                            </div>
                            <div class="mt-1">
                                <field name="status" widget="label_selection"
                                       options="{'classes': {'draft': 'secondary', 'confirmed': 'success'}}"/>
                            </div>  

                            <div t-if="record.class_id.raw_value" class="mt-1">
                                Class: <field name="class_id" string="Class"/>
                            </div>
                            
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Student Search View -->
    <record id="view_student_search" model="ir.ui.view">
        <field name="name">student.search</field>
        <field name="model">student.information</field>
        <field name="arch" type="xml">
            <search string="Search Student Information">
                <field
                    name="name"
                    filter_domain="[('name', 'ilike', self)]"
                />
                <field name="roll_number"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="class_id"/>

                <filter
                    string="Male"
                    name="gender_male"
                    domain="[('gender', '=', 'male')]"
                />
                <filter
                    string="Female"
                    name="gender_female"
                    domain="[('gender', '=', 'female')]"
                />
                <separator/>

                <group name="group_by">
                    <filter name="gender" string="Gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>   

    <!-- Window Action -->
    <record id="student_information_action" model="ir.actions.act_window">
        <field name="name">Student Information</field>
        <field name="res_model">student.information</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_student_information_list"/>
        <field name="help" type="html">
            <h3 class="o_view_nocontent_smiling_face">
                Create your first student information
            </h3>
            <p>
                Click on the "Create" button to add a new student information.
            </p>
        </field>
    </record>

    <!-- Main Menu -->
    <menuitem id="school_management_menu" name="School Management"/>

    <!-- Student Sub Menu -->
    <menuitem id="student_information_menu"
              name="Student Information"
              parent="school_management_menu"
              action="student_information_action"
              sequence="1"/>

</odoo>
