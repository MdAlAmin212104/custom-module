<?xml version="1.0" encoding="UTF-8"?>
    <odoo>
        

    <!-- Class List View -->
    <record id="view_class_information_list" model="ir.ui.view">
        <field name="name">class.information.list</field>
        <field name="model">class.information</field>
        <field name="arch" type="xml">
            <list editable="top" string="Class Information">
               <field name="name"/>
                <field name="class_teacher_id"/>
                <field name="number_of_seats"/>
            </list>
        </field>
    </record>



    <!-- Window Action -->
    <record id="class_information_action" model="ir.actions.act_window">
        <field name="name">Class Information</field>
        <field name="res_model">class.information</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_class_information_list"/>
        <field name="help" type="html">
            <h3 class="o_view_nocontent_smiling_face">
                Create your first class information
            </h3>
            <p>
                Click on the "Create" button to add a new class information.
            </p>
        </field>
    </record>


    <!-- Class Sub Menu -->
    <menuitem id="class_information_menu"
              name="Class Information"
              parent="school_management_menu"
              action="class_information_action"
              sequence="2"/>

</odoo>